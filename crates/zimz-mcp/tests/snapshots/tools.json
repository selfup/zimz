  {
    "name": "search",
    "description": "Full-text search across the selected archives (all by default). Terms are ANDed and stemmed per archive language; rankings are fused across archives and exact title matches are boosted. When AND matches fewer than a page, OR matches are appended and flagged `partial`. Returns paths for `read_article`, snippets and a `next_cursor`.",
    "inputSchema": {
      "$defs": {
        "ModeSelect": {
          "description": "Which tier to use per archive.",
          "oneOf": [
            {
              "enum": [
                "fulltext",
                "title",
                "listing"
              ],
              "type": "string"
            },
            {
              "const": "auto",
              "description": "Full-text index when present, else the title index, else the title listing.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "archives": {
          "default": [],
          "description": "Archive names, uuids, file stems or globs; empty = every archive.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cursor": {
          "default": null,
          "description": "Opaque cursor from a previous response to fetch the next page.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": 10,
          "description": "Hits per page (1..=50).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "min_score": {
          "default": null,
          "description": "Drop hits whose normalised score (1.0 = best) is below this.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/ModeSelect",
          "default": "auto"
        },
        "or_fallback": {
          "default": true,
          "description": "When an AND query fills less than a page, add OR matches after the AND hits.",
          "type": "boolean"
        },
        "query": {
          "type": "string"
        },
        "snippet_chars": {
          "default": 300,
          "description": "Maximum characters per snippet; 0 disables snippets.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Mode": {
          "description": "How an archive is searched.",
          "oneOf": [
            {
              "const": "fulltext",
              "description": "Embedded Xapian full-text index (`X/fulltext/xapian`): BM25 over article bodies.",
              "type": "string"
            },
            {
              "const": "title",
              "description": "Embedded Xapian title index (`X/title/xapian`): word-prefix matching on titles.",
              "type": "string"
            },
            {
              "const": "listing",
              "description": "Title listing prefix scan (no Xapian index in the archive).",
              "type": "string"
            }
          ]
        },
        "SearchHit": {
          "properties": {
            "archive": {
              "type": "string"
            },
            "mode": {
              "$ref": "#/$defs/Mode"
            },
            "partial": {
              "description": "True when the hit matched only some of the query terms (OR fallback).",
              "type": "boolean"
            },
            "path": {
              "description": "Path to pass to `read_article` (canonical, redirects resolved when known).",
              "type": "string"
            },
            "percent": {
              "description": "Xapian's relevance percentage within the archive (100 = best in that archive).",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "rank": {
              "description": "1-based position across the whole result list.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "score": {
              "description": "Fused score normalised so the best hit is 1.0.",
              "format": "double",
              "type": "number"
            },
            "snippet": {
              "description": "Best window of the article text around the query terms (`**term**` marks\nmatches), when requested and extractable.",
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string"
            },
            "uri": {
              "description": "`zim://archive/path`.",
              "type": "string"
            },
            "word_count": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "rank",
            "archive",
            "path",
            "title",
            "uri",
            "score",
            "percent",
            "mode",
            "partial"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "archives_searched": {
          "description": "Number of archives that were searched (see `list_archives` for names).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "elapsed_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "fallback_used": {
          "description": "OR matches were appended because AND matched fewer than a page.",
          "type": "boolean"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/SearchHit"
          },
          "type": "array"
        },
        "next_cursor": {
          "description": "Pass back as `cursor` to get the next page; absent on the last page.",
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "type": "string"
        },
        "total_estimate": {
          "description": "Sum of per-archive match counts (before fusion and de-duplication).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "description": "Archives that were selected but skipped (no usable index) or failed.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "query",
        "hits",
        "total_estimate",
        "fallback_used",
        "archives_searched",
        "warnings",
        "elapsed_ms"
      ],
      "type": "object"
    },
    "annotations": {
      "title": "Search archives",
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
