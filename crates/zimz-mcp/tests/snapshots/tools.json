        },
        "redirected_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "description": "Title of the section that was selected, when `section` was given.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "total_chars": {
          "description": "Characters in the whole document (or selected section).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        },
        "uri": {
          "type": "string"
